{
    "family": "website",
    "containerDefinitions": [
        {
            "name": "website",
            "image": "618246140803.dkr.ecr.us-east-1.amazonaws.com/website:GIT_COMMIT",
            "cpu": 300,
            "memory": 300,
            "memoryReservation": 200,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 0,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/website",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "website"
                }
            },
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::618246140803:role/ecsTaskRole",
    "volumes": [],
    "placementConstraints": []
}